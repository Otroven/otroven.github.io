---
import { SITE_TITLE, NAV_LINKS } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const path = new URL(Astro.request.url).pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="site-nav">
  <div class="container nav-inner">
    <a class="wordmark" href="/">
      <svg viewBox="0 0 20 20" aria-hidden="true">
        <circle cx="10" cy="10" r="8.3" fill="none" stroke="currentColor" stroke-width="1.3" opacity="0.35" />
        <circle cx="10" cy="10" r="3.4" fill="currentColor" />
      </svg>
      <span>{SITE_TITLE}</span>
    </a>

    <nav aria-label="주요 메뉴">
      <ul>
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  .site-nav {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: saturate(1.1);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
    max-width: var(--measure-wide);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--ink);
    text-decoration: none;
    flex-shrink: 0;
  }

  .wordmark svg {
    width: 1.2rem;
    height: 1.2rem;
    color: var(--accent);
  }

  nav {
    flex: 1;
    overflow-x: auto;
  }

  nav ul {
    display: flex;
    gap: 0.3rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    font-family: var(--font-mono);
    font-size: 0.83rem;
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  nav a:hover {
    color: var(--ink);
    background: var(--bg-sunken);
  }

  nav a[aria-current='page'] {
    color: var(--accent);
    background: var(--accent-soft);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .nav-inner {
      gap: 0.9rem;
    }
    nav ul {
      gap: 0.9rem;
    }
    .wordmark span {
      display: none;
    }
  }
</style>
