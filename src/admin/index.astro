        align-items: center;
        gap: 0.7rem;
        padding: 0.7rem 1.1rem;
        border-bottom: 1px solid var(--border);
        background: var(--bg-raised);
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.02rem;
      }

      .brand svg {
