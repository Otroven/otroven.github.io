        text-transform: none;
        letter-spacing: 0;
        opacity: 0.75;
      }

      .field input[type='text'],
      .field input[type='date'],
      .field select {
        font-family: var(--font-body);
        font-size: 0.92rem;
        color: var(--ink);
        background: var(--bg);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius);
        padding: 0.45em 0.6em;
        min-width: 0;
      }

      .field input.mono,
      .field select {
        font-family: var(--font-mono);
        font-size: 0.85rem;
      }

      .field input:focus-visible,
      .field select:focus-visible,
      textarea:focus-visible {
        outline: 2px solid var(--focus-ring);
        outline-offset: 1px;
      }

      #f-title {
        font-family: var(--font-display);
        font-size: 1.05rem;
        font-weight: 600;
      }

      .field-check {
        flex-direction: row;
        align-items: center;
        gap: 0.4rem;
        padding-bottom: 0.5rem;
        white-space: nowrap;
      }

      .field-check input {
        accent-color: var(--accent);
        width: 1rem;
        height: 1rem;
      }

      /* ---------- 작업 영역 ---------- */
      .workspace {
        flex: 1;
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        min-height: 0;
      }

      .workspace.is-split {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      }

      .pane {
        display: flex;
        flex-direction: column;
        min-height: 0;
        min-width: 0;
      }

      .pane-preview {
        border-left: 1px solid var(--border);
      }

      .pane-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 0.45rem 1.2rem;
        border-bottom: 1px solid var(--border);
        background: var(--bg-raised);
      }

      .pane-label,
      .pane-meta {
        font-family: var(--font-mono);
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--ink-faint);
      }

      .pane-meta {
        text-transform: none;
      }

      .pane-live {
        color: var(--accent);
        background: var(--accent-soft);
        border-radius: 999px;
        padding: 0.12em 0.5em;
        margin-left: 0.3em;
      }

      .pane-btn {
        font-family: var(--font-mono);
        font-size: 0.68rem;
        color: var(--ink-soft);
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
      }

      .pane-btn:hover {
        color: var(--ink);
      }

      /* ---------- 툴바 ---------- */
      .toolbar {
        display: flex;
        align-items: center;
        gap: 0.2rem;
        flex-wrap: wrap;
        padding: 0.4rem 1.2rem;
        border-bottom: 1px solid var(--border);
      }

      .tb {
        font-family: var(--font-mono);
        font-size: 0.74rem;
        line-height: 1;
        color: var(--ink-soft);
        background: none;
        border: 1px solid transparent;
        border-radius: var(--radius);
        padding: 0.38em 0.55em;
        cursor: pointer;
        min-width: 1.9rem;
      }

      .tb:hover {
        color: var(--ink);
        background: var(--bg-sunken);
        border-color: var(--border);
      }

      .tb b,
      .tb i {
        font-family: var(--font-display);
        font-size: 0.92rem;
      }

      .tb-sep {
        width: 1px;
        height: 1.1rem;
        background: var(--border);
        margin: 0 0.35rem;
      }

      textarea.is-dropping {
        outline: 2px dashed var(--accent);
        outline-offset: -4px;
      }

      textarea {
        flex: 1;
        resize: none;
        border: none;
        outline-offset: -2px;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-mono);
        font-size: 0.9rem;
        line-height: 1.75;
        padding: 1.1rem 1.2rem;
        min-height: 0;
        tab-size: 2;
      }

      iframe {
        flex: 1;
        width: 100%;
        border: none;
        background: var(--bg);
        min-height: 0;
      }

      /* ---------- 하단 ---------- */
      .editor-foot {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        padding: 0.55rem 1.2rem;
        border-top: 1px solid var(--border);
        background: var(--bg-raised);
      }

      .file-path {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: var(--ink-faint);
      }

      @media (max-width: 900px) {
        .main {
          grid-template-columns: 12rem minmax(0, 1fr);
        }
        .workspace.is-split {
          grid-template-columns: minmax(0, 1fr);
          grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
        }
      }
    </style>
  </body>
</html>
