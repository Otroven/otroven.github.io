---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TagPill from '../../components/TagPill.astro';
import { formatDate } from '../../lib/collections';

export async function getStaticPaths() {
  const entries = await getCollection('library', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, author, status, rating, pubDate, tags } = entry.data;
---

<Base title={title} description={`${author} — ${status}`} type="article">
  <article class="post container--narrow">
    <header class="post-header">
      <p class="kind-label">Library</p>
      <h1>{title}</h1>
      <p class="book-author">{author}</p>
      <div class="post-meta meta">
        <span>{status}</span>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {rating && <span class="stars">{'★'.repeat(rating)}{'☆'.repeat(5 - rating)}</span>}
      </div>
      {
        tags.length > 0 && (
          <div class="post-tags">
            {tags.map((t) => (
              <TagPill tag={t} />
            ))}
          </div>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="post-footer">
      <a href="/library/">← Library 목록으로</a>
    </footer>
  </article>
</Base>

<style>
  .post {
    padding: 2.5rem 0 4rem;
    margin: 0 auto;
  }
  .post-header {
    margin-bottom: 2.5rem;
  }
  .post-header h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin-top: 0.3rem;
    margin-bottom: 0.2rem;
  }
  .book-author {
    font-style: italic;
    color: var(--ink-soft);
    margin: 0 0 0.6rem;
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.8em;
    flex-wrap: wrap;
  }
  .stars {
    color: var(--accent);
    letter-spacing: 0.05em;
  }
  .post-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }
  .post-footer {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .post-footer a {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    text-decoration: none;
  }
</style>
