---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { HOME_HEADLINE, HOME_SUBTITLE, HOME_BODY } from '../consts';
import { COLLECTION_META, byDateDesc, formatDate } from '../lib/collections';

const essays = byDateDesc(await getCollection('essays', ({ data }) => !data.draft)).slice(0, 4);
const tech = byDateDesc(await getCollection('tech', ({ data }) => !data.draft)).slice(0, 10);
const library = byDateDesc(await getCollection('library', ({ data }) => !data.draft)).slice(0, 8);
---

<Base>
  <section class="hero">
    <h1>{HOME_HEADLINE}</h1>
    <p class="hero-subtitle">{HOME_SUBTITLE}</p>
    <p class="hero-body">{HOME_BODY}</p>
  </section>

  <!-- Essays — 카드 그리드 -->
  <section class="home-section">
    <header class="section-head">
      <h2><a href="/essays/">Essays</a></h2>
      <p class="section-desc">{COLLECTION_META.essays.description}</p>
    </header>

    {
      essays.length > 0 ? (
        <div class="essay-grid">
          {essays.map((entry) => (
            <a class="essay-card" href={`/essays/${entry.id}/`}>
              <h3>{entry.data.title}</h3>
              <p class="essay-excerpt">{entry.data.description}</p>
              <span class="meta">{formatDate(entry.data.pubDate)}</span>
            </a>
          ))}
        </div>
      ) : (
        <p class="meta empty">아직 쓴 에세이가 없습니다.</p>
      )
    }

    <a class="section-more" href="/essays/">에세이 전체 보기 →</a>
  </section>

  <!-- Tech — 제목만 있는 느슨한 목록 -->
  <section class="home-section">
    <header class="section-head">
      <h2><a href="/tech/">Tech</a></h2>
      <p class="section-desc">{COLLECTION_META.tech.description}</p>
    </header>

    {
      tech.length > 0 ? (
        <ul class="note-list">
          {tech.map((entry) => (
            <li>
              <a href={`/tech/${entry.id}/`}>{entry.data.title}</a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="meta empty">아직 쓴 메모가 없습니다.</p>
      )
    }

    <a class="section-more" href="/tech/">테크 노트 전체 보기 →</a>
  </section>

  <!-- Library — 책 타일 그리드 -->
  <section class="home-section">
    <header class="section-head">
      <h2><a href="/library/">Library</a></h2>
      <p class="section-desc">{COLLECTION_META.library.description}</p>
    </header>

    {
      library.length > 0 ? (
        <div class="book-grid">
          {library.map((entry) => (
            <a class="book-tile" href={`/library/${entry.id}/`}>
              <span class="book-spine">
                <span class="book-title">{entry.data.title}</span>
                <span class="book-author">{entry.data.author}</span>
              </span>
              <span class="book-foot">
                <span class="kind-label">{entry.data.status}</span>
                {entry.data.rating && (
                  <span class="stars" aria-label={`별 ${entry.data.rating}개`}>
                    {'★'.repeat(entry.data.rating)}
                  </span>
                )}
              </span>
            </a>
          ))}
        </div>
      ) : (
        <p class="meta empty">아직 기록한 책이 없습니다.</p>
      )
    }

    <a class="section-more" href="/library/">서재 전체 보기 →</a>
  </section>
</Base>

<style>
  /* ---------- 히어로 ---------- */
  .hero {
    padding: 4rem 0 3rem;
    max-width: 48rem;
  }

  .hero h1 {
    font-size: clamp(2rem, 5.2vw, 3.1rem);
    line-height: 1.2;
    margin: 0 0 0.6rem;
  }

  .hero-subtitle {
    font-size: 1.1rem;
    color: var(--ink-soft);
    margin: 0 0 1rem;
  }

  .hero-body {
    color: var(--ink-soft);
    max-width: 38rem;
    margin: 0;
  }

  /* ---------- 섹션 공통 ---------- */
  .home-section {
    padding: 2.8rem 0;
    border-top: 1px solid var(--border);
  }

  .home-section:last-child {
    padding-bottom: 4.5rem;
  }

  .section-head {
    margin-bottom: 1.6rem;
    max-width: var(--measure);
  }

  .section-head h2 {
    font-size: clamp(1.5rem, 3.4vw, 2rem);
    margin: 0 0 0.25rem;
  }

  .section-head h2 a {
    color: var(--ink);
    text-decoration: none;
  }

  .section-head h2 a:hover {
    color: var(--accent);
  }

  .section-desc {
    color: var(--ink-soft);
    font-size: 0.98rem;
    margin: 0;
  }

  .section-more {
    display: inline-block;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .section-more:hover {
    text-decoration: underline;
  }

  .empty {
    margin: 0;
  }

  /* ---------- Essays: 카드 그리드 ---------- */
  .essay-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .essay-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.4rem 1.3rem;
    background: var(--bg);
    text-decoration: none;
    color: inherit;
    transition: background-color 0.15s ease;
  }

  .essay-card:hover {
    background: var(--bg-sunken);
  }

  .essay-card h3 {
    font-size: 1.12rem;
    font-weight: 600;
    margin: 0;
    color: var(--ink);
  }

  .essay-excerpt {
    flex: 1;
    margin: 0;
    font-size: 0.93rem;
    color: var(--ink-soft);
  }

  /* ---------- Tech: 제목 목록 ---------- */
  .note-list {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: 2.5rem;
    max-width: var(--measure-wide);
  }

  .note-list li {
    break-inside: avoid;
    padding: 0.42rem 0;
  }

  .note-list a {
    text-decoration: none;
    text-decoration-color: var(--border-strong);
  }

  .note-list a:hover {
    text-decoration: underline;
  }

  /* ---------- Library: 책 타일 ---------- */
  .book-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: 1.1rem;
  }

  .book-tile {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.9rem;
    min-height: 13rem;
    padding: 1rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-raised);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .book-tile:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }

  .book-spine {
    display: block;
    border-left: 2px solid var(--accent);
    padding-left: 0.7rem;
  }

  .book-title {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.98rem;
    line-height: 1.3;
    color: var(--ink);
  }

  .book-author {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.83rem;
    font-style: italic;
    color: var(--ink-soft);
  }

  .book-foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem;
  }

  .stars {
    font-size: 0.75rem;
    color: var(--accent);
    letter-spacing: 0.04em;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 2.5rem 0 2rem;
    }
    .note-list {
      columns: 1;
    }
  }
</style>
