---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EntryCard from '../components/EntryCard.astro';
import { SITE_TITLE, SITE_TAGLINE } from '../consts';
import { COLLECTION_META, type CollectionKind } from '../lib/collections';

const kinds: CollectionKind[] = ['essays', 'tech', 'library'];

const allEntries = (
  await Promise.all(
    kinds.map(async (kind) => {
      const entries = await getCollection(kind, ({ data }) => !data.draft);
      return entries.map((entry) => ({ kind, entry }));
    })
  )
).flat();

// kind를 유지한 채로 날짜 정렬
const recentWithKind = allEntries
  .sort((a, b) => b.entry.data.pubDate.valueOf() - a.entry.data.pubDate.valueOf())
  .slice(0, 10);

const counts = kinds.map((kind) => ({
  kind,
  meta: COLLECTION_META[kind],
  count: allEntries.filter((e) => e.kind === kind).length,
}));
---

<Base>
  <section class="hero">
    <h1>{SITE_TITLE}</h1>
    <p class="hero-tagline">{SITE_TAGLINE}</p>
    <p class="hero-body">
      개발하면서 떠오른 생각, 배운 것, 읽은 것들을 기록합니다.
      완벽하게 정리되지 않은 글도 그냥 올립니다.
    </p>

    <nav class="hero-sections" aria-label="섹션 바로가기">
      {
        counts.map(({ kind, meta, count }) => (
          <a class="hero-section" href={`${meta.path}/`}>
            <span class="kind-label">{meta.label}</span>
            <span class="hero-count">{count}</span>
          </a>
        ))
      }
    </nav>
  </section>

  <section class="recent">
    <h2 class="recent-heading">최근 글</h2>
    <div class="entry-list">
      {
        recentWithKind.map(({ kind, entry }) => (
          <EntryCard
            kind={kind}
            slug={entry.id}
            title={entry.data.title}
            description={'description' in entry.data ? entry.data.description : undefined}
            pubDate={entry.data.pubDate}
            tags={entry.data.tags}
          />
        ))
      }
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 3.5rem 0 2.5rem;
    max-width: var(--measure);
  }

  .hero h1 {
    font-size: clamp(2.2rem, 5.5vw, 3rem);
    margin: 0.25em 0 0.15em;
  }

  .hero-tagline {
    font-size: 1.05rem;
    color: var(--ink-soft);
    margin: 0 0 1.1rem;
  }

  .hero-body {
    color: var(--ink-soft);
    max-width: 36rem;
  }

  .hero-sections {
    display: flex;
    gap: 1.6rem;
    margin-top: 2.2rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
  }

  .hero-section {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--ink-soft);
  }

  .hero-section:hover {
    color: var(--ink);
  }

  .hero-count {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ink-faint);
  }

  .recent {
    padding-bottom: 4rem;
    max-width: var(--measure-wide);
  }

  .recent-heading {
    font-size: 0.9rem;
    font-family: var(--font-mono);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
    margin-bottom: 0.4rem;
  }
</style>
