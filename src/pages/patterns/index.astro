---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryCard from '../../components/EntryCard.astro';
import { COLLECTION_META, byDateDesc } from '../../lib/collections';

const meta = COLLECTION_META.patterns;
const entries = byDateDesc(await getCollection('patterns', ({ data }) => !data.draft));
---

<Base title="Patterns" description={meta.description}>
  <header class="list-header">
    <p class="kind-label">Pattern</p>
    <h1>패턴</h1>
    <p class="list-desc">{meta.description}</p>
  </header>
  <div class="entry-list">
    {
      entries.map((entry) => (
        <EntryCard
          kind="patterns"
          slug={entry.id}
          title={entry.data.title}
          description={entry.data.description}
          pubDate={entry.data.pubDate}
          stage={entry.data.stage}
          tags={entry.data.tags}
        />
      ))
    }
    {entries.length === 0 && <p class="meta">아직 글이 없습니다.</p>}
  </div>
</Base>

<style>
  .list-header {
    padding: 3rem 0 2rem;
    max-width: var(--measure);
  }
  .list-header h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    margin-top: 0.3rem;
  }
  .list-desc {
    color: var(--ink-soft);
  }
  .entry-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-bottom: 4rem;
    max-width: var(--measure-wide);
  }
</style>
